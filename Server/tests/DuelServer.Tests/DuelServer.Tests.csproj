  </ItemGroup>

  <!-- Unity의 전투 공식 테스트와 같은 기대값(웹게임이 계산한 값)으로 서버의 피해 공식을 본다. -->
  <ItemGroup>
    <None Include="../../../Assets/MiniPandoras/Tests/EditMode/Fixtures/battle_formulas.json" Link="Fixtures/battle_formulas.json" CopyToOutputDirectory="PreserveNewest" />
